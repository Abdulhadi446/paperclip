# LLM (any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional comma-separated list shown in the model selector
OPENAI_MODELS=

# Path to a Chromium/Chrome binary used for server-side PDF rendering
CHROMIUM_PATH=/usr/bin/chromium

# Set to 1 to stream a built-in demo document instead of calling the model
PAPERCLIP_MOCK=0
